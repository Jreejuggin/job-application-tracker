# Copy this to .env in the same folder as docker-compose.yml, then fill in the values.

# CRITICAL: this must be the EXACT same key your current npm-based n8n instance uses,
# or every stored credential becomes permanently undecryptable. Find it in ~/.n8n/config
# or wherever you currently set N8N_ENCRYPTION_KEY as an environment variable.
N8N_ENCRYPTION_KEY=

# Update these once you know your real hostname/domain (leave as-is for local testing)
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5679/

GENERIC_TIMEZONE=America/Toronto
